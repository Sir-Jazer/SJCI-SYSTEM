# =============================================================================
# SJCI SYSTEM — production environment template
# Copy this to `.env` ON THE SERVER, then fill in the blanks.
# NEVER commit the real .env (it is git-ignored). This example carries no secrets.
# =============================================================================

APP_NAME="Shepherd Jubillee Church Inc."
APP_ENV=production
# Generate ONCE on the server:  php artisan key:generate
APP_KEY=
# Turn OFF in production — a debug page would leak code and config to visitors.
APP_DEBUG=false

# For now this is your server's public IP (http, no domain yet).
# When you add a domain + HTTPS, change to e.g. https://sjci.example.com
APP_URL=http://YOUR_SERVER_IP

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# Philippine church — show dates/times in local time from day one.
APP_TIMEZONE=Asia/Manila

# Only log real problems in production.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database: SQLite (single file) ------------------------------------------
# Use an ABSOLUTE path in production so cron/backup scripts resolve it too.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/sjci/database/database.sqlite
# (leave the rest of the DB_* keys unset — SQLite ignores them)

# --- Sessions / cache / queue ------------------------------------------------
# The users migration already creates the sessions table; cache/jobs tables exist too.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# IMPORTANT: keep false while on plain http://IP. Flip to true the moment you
# move to https:// — otherwise the login cookie won't be sent and no one can log in.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database

# sync = jobs run immediately, in-process. No background worker to babysit.
# (Fine for this app's volume. Revisit only if you add heavy async work.)
QUEUE_CONNECTION=sync

# --- Mail: real SMTP so "Forgot password?" actually sends --------------------
# Until you fill this in, leave MAIL_MAILER=log and reset links appear in
# storage/logs/laravel.log (fine for first testing; pastors can't self-reset yet).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@sjci.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Filament ----------------------------------------------------------------
# Bump this string whenever you want to force browsers to reload panel assets.
# (optional)